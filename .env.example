# ============================================================
# RedOps Automático — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your lab values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Metasploit RPC Configuration
# ----------------------------------------------------------
# Host where msfrpcd is running (typically localhost on Kali)
MSF_HOST=127.0.0.1
# RPC port (default msfrpcd port)
MSF_PORT=55553
# Password set when launching msfrpcd: msfrpcd -P <password>
MSF_PASSWORD=msf_rpc_password
# Disable SSL for local lab (set true if using encrypted RPC)
MSF_SSL=false

# ----------------------------------------------------------
# Ollama LLM Configuration
# ----------------------------------------------------------
# Host where Ollama service is running
OLLAMA_HOST=127.0.0.1
# Ollama API port (default)
OLLAMA_PORT=11434
# Model to use for decision-making (must be pulled first: ollama pull mistral)
OLLAMA_MODEL=mistral
# Maximum seconds to wait for a single LLM response
OLLAMA_TIMEOUT=120

# ----------------------------------------------------------
# Attacker Identity (Reverse Payloads)
# ----------------------------------------------------------
# IP of the attacking machine on the lab network.
# Required for reverse payloads (samba, distcc, unreal, php_cgi, etc.).
# Leave empty to auto-detect from the interface facing TARGET_NETWORK.
# On Arch Linux with VirtualBox Host-Only: usually 192.168.56.1
# On Kali VM (Adapter 2):                  usually 192.168.56.1 (eth1)
LHOST=

# ----------------------------------------------------------
# Scan / Target Configuration
# ----------------------------------------------------------
# CIDR notation of the lab network (Host-Only adapter)
TARGET_NETWORK=192.168.56.0/24
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory where PDF reports are saved
REPORT_OUTPUT_DIR=./reports

# ----------------------------------------------------------
# Evasion Timing (seconds)
# ----------------------------------------------------------
# Minimum delay between network operations
SCAN_TIMING_MIN=1.0
# Maximum delay between network operations
SCAN_TIMING_MAX=5.0
# Evasion profile: stealth | balanced | aggressive
EVASION_PROFILE=balanced

# ----------------------------------------------------------
# Pipeline Configuration
# ----------------------------------------------------------
# Maximum minutes for the entire pipeline execution
GLOBAL_TIMEOUT_MINUTES=15
# Minimum services that must be compromised to consider engagement successful
MIN_SERVICES_TO_COMPROMISE=3
# Seconds between automatic checkpoint saves
CHECKPOINT_INTERVAL_SECONDS=60
